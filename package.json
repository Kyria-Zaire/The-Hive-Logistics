{
  "name": "the-hive-logistics",
  "private": true,
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "10.16.1"
  },
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:lint": "pnpm --filter web lint",
    "web:typecheck": "pnpm --filter web exec tsc --noEmit",
    "web:build": "pnpm --filter web build",
    "api:dev": "uv run --directory apps/api uvicorn thl_api.main:app --host 127.0.0.1 --port 8000 --reload",
    "api:lint": "uv run --directory apps/api ruff check .",
    "api:typecheck": "uv run --directory apps/api mypy src",
    "api:test": "uv run --directory apps/api pytest -m \"not integration\"",
    "api:test:integration": "uv run --directory apps/api pytest -m integration",
    "check": "pnpm web:lint && pnpm web:typecheck && pnpm web:build && pnpm api:lint && pnpm api:typecheck && pnpm api:test"
  },
  "packageManager": "pnpm@10.16.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
