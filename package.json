{
  "name": "the-hive-logistics",
  "private": true,
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "10.16.1"
  },
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:lint": "pnpm --filter web lint",
    "web:typecheck": "pnpm --filter web typecheck",
    "web:build": "pnpm --filter web build",
    "api:dev": "uv run --directory apps/api uvicorn thl_api.main:app --host 127.0.0.1 --port 8000 --reload",
    "api:lint": "uv run --directory apps/api ruff check .",
    "api:typecheck": "uv run --directory apps/api mypy src",
    "api:openapi:check": "uv run --directory apps/api python ../../scripts/check_openapi_drift.py",
    "api:test": "uv run --directory apps/api pytest -m \"not integration and not migrations\"",
    "api:test:integration": "uv run --directory apps/api pytest -m integration",
    "api:migrate:upgrade": "uv run --directory apps/api alembic upgrade head",
    "api:migrate:check": "uv run --directory apps/api alembic check",
    "api:test:migrations": "uv run --directory apps/api pytest -m migrations",
    "api:worker": "uv run --directory apps/api python -m thl_api.notifications.worker",
    "api:worker:once": "uv run --directory apps/api python -m thl_api.notifications.worker --once",
    "api:test:worker": "uv run --directory apps/api pytest -m worker",
    "check": "pnpm web:lint && pnpm web:typecheck && pnpm web:build && pnpm api:lint && pnpm api:typecheck && pnpm api:openapi:check && pnpm api:test"
  },
  "packageManager": "pnpm@10.16.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
