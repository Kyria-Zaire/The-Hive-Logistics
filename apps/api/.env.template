# THE HIVE LOGISTICS — API (DEV / local uniquement, jamais PROD)
# Copier vers .env en local ; ne jamais committer .env

THL_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Identifiants DEV locaux — interdits si THL_ENV=prod
DATABASE_URL=postgresql+psycopg://thl_dev:thl_dev_password@127.0.0.1:5432/thl_dev

# Politique de confidentialité (version serveur)
PRIVACY_POLICY_VERSION=2026-01-dev

# Idempotence (TTL DEV)
IDEMPOTENCY_TTL_SECONDS=86400
FINGERPRINT_ALGO_VERSION=1

# HMAC DEV — placeholders locaux uniquement
IDEMPOTENCY_HMAC_SECRET_CURRENT=dev-idempotency-hmac-secret-32bytes!!
IDEMPOTENCY_HMAC_SECRET_CURRENT_VERSION=1
FINGERPRINT_HMAC_SECRET_CURRENT=dev-fingerprint-hmac-secret-32bytes!!
FINGERPRINT_HMAC_SECRET_CURRENT_VERSION=1
RATE_LIMIT_HMAC_SECRET_CURRENT=dev-rate-limit-hmac-secret-32bytes!!!!
RATE_LIMIT_HMAC_SECRET_CURRENT_VERSION=1

# Rate limit DEV (seuils PROD obligatoires via env)
RATE_LIMIT_QUOTE_REQUESTS_MAX=120
RATE_LIMIT_QUOTE_REQUESTS_WINDOW_SECONDS=3600
RATE_LIMIT_CONTACT_MESSAGES_MAX=120
RATE_LIMIT_CONTACT_MESSAGES_WINDOW_SECONDS=3600

# Cloudflare Turnstile (DEV placeholder)
TURNSTILE_SECRET_KEY=dev-turnstile-secret-placeholder
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Proxy de confiance (SEC-016) — false par défaut
TRUSTED_PROXY_ENABLED=false

# Worker notifications internes (DEV — configurer avant lancement worker)
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_SMTP_STARTTLS=true
NOTIFICATION_SMTP_USE_TLS=false
# Identifiant instance worker (optionnel, max 64 car.)
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=1.0
