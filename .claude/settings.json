{
    "$schema":  "https://json.schemastore.org/claude-code-settings.json",
    "permissions":  {
                        "ask":  [
                                    "Bash(git commit *)",
                                    "Bash(git push *)",
                                    "Bash(pnpm add *)",
                                    "Bash(npm install *)",
                                    "Bash(uv add *)",
                                    "Bash(pip install *)",
                                    "Bash(alembic upgrade *)"
                                ],
                        "deny":  [
                                     "Read(./.env)",
                                     "Read(./.env.local)",
                                     "Read(./.env.production)",
                                     "Read(./.env.production.local)",
                                     "Read(./**/.env)",
                                     "Read(./**/.env.local)",
                                     "Read(./**/.env.production)",
                                     "Read(./**/.env.production.local)",
                                     "Read(./**/secrets/**)",
                                     "Bash(git push --force *)",
                                     "Bash(git push -f *)",
                                     "Bash(git reset --hard *)",
                                     "Bash(rm -rf *)",
                                     "Bash(docker system prune *)",
                                     "Bash(terraform destroy *)",
                                     "Bash(kubectl delete *)"
                                 ]
                    }
}